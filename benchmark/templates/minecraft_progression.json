{
  "id": "minecraft_progression",
  "name": "Minecraft survival progression curriculum",
  "version": "1.0.0",
  "status": "adapter-required",
  "environment": {
    "game": "Minecraft Java Edition",
    "mode": "survival",
    "difficulty": "normal",
    "observation": "pixels_plus_inventory",
    "action_space": "keyboard_mouse",
    "world_generation": "fresh_seeded_world",
    "terminal_success": "ordered_progression_milestones"
  },
  "objective": "Measure learnable short-horizon capabilities that compose toward the Ender Dragon benchmark.",
  "adapter": {
    "protocol": "jsonl-episode-v1",
    "suggested_backends": ["MineRL-compatible bridge", "Project Malmo-compatible bridge"],
    "required_artifacts": ["event_log", "inventory_log", "world_seed_hash"]
  },
  "training_budget": {
    "environment_steps": 5000000,
    "maximum_wall_hours": 24,
    "maximum_parallel_worlds": 32,
    "starting_checkpoint": "required"
  },
  "evaluation": {
    "episode_step_limit": 72000,
    "milestones": ["craft_stone_pickaxe", "obtain_iron_ingot", "obtain_diamond", "enter_nether", "obtain_blaze_rod"],
    "quick": {"public_worlds": 16},
    "confirmation": {"hidden_worlds": 64, "paired_with_parent": true},
    "seed_policy": "commit-reveal; stratified across biome and spawn difficulty"
  },
  "metrics": {
    "primary": "normalized_progression_score",
    "direction": "max",
    "secondary": ["milestone_success_rates", "median_steps_per_milestone", "agent_death_rate", "environment_steps", "wall_seconds"]
  },
  "fairness": [
    "score weights fixed before training",
    "milestones must be completed in survival play",
    "same checkpoint, training worlds and environment-step budget",
    "parent and candidate evaluated on identical hidden worlds"
  ],
  "integrity": [
    "server-side milestone verification",
    "no commands, creative mode, save loading or item injection",
    "hidden evaluation seeds",
    "retain logs for anomalous milestone jumps"
  ]
}
